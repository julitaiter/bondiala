# Desarrollo: docker compose up --build funciona también sin .env.
PORT=8080
DJANGO_DEBUG=True
# Obligatoria en producción: generar con python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
BOOTSTRAP_DEMO=true
DB_NAME=bondiala
DB_USER=bondiala
DB_PASSWORD=local-development-only
DB_HOST=db
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=local-admin-development-only
# Solo desarrollo: permite crear una base aislada para los tests.
DB_ALLOW_CREATEDB=true
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
HSTS_SECONDS=0
BADATA_RECORRIDOS_URL=https://cdn.buenosaires.gob.ar/datosabiertos/datasets/transporte-y-obras-publicas/colectivos-recorridos/recorrido-colectivos.geojson
BADATA_RECORRIDOS_FILE=/data/recorrido-colectivos.csv
# Sin fuente oficial fijada: ver el contrato de paradas en docs/importaciones.md.
BADATA_PARADAS_URL=
IMPORT_TIMEOUT=45
IMPORT_MAX_BYTES=157286400
# Endpoint auxiliar compatible con el contrato documentado; opcional.
USIG_URL=
API_INTERNAL_URL=http://backend:8000
# Vacías: raster OpenStreetMap para desarrollo. Producción: proveedor propio/configurado.
MAP_STYLE_LIGHT_URL=
MAP_STYLE_DARK_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bondiala <cuentas@bondiala.com.ar>
# Producción: directorio que contiene fullchain.pem y privkey.pem.
TLS_CERTS_DIR=./certs
