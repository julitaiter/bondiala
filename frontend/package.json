{
  "name": "bondiala-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
